{
	"nodes":[
		{"type":"text","text":"# Evolució de les parts\n\nCada fila és una part; cada columna, l'estat dominant en una etapa. **No és una cronologia exacta**: és el que ja existia o ja funcionava en aquell moment.","id":"n1","x":-280,"y":-260,"width":1900,"height":120,"color":"6"},
		{"type":"text","text":"## 0 · Paper\nAgost 2026 · el pla sense codi","id":"n2","x":0,"y":-110,"width":300,"height":80,"color":"1"},
		{"type":"text","text":"## 1 · Prototip\nPC · Pygame i Groq","id":"n3","x":340,"y":-110,"width":300,"height":80,"color":"5"},
		{"type":"text","text":"## 2 · Primera placa\n17-24/10 · mesurar","id":"n4","x":680,"y":-110,"width":300,"height":80,"color":"3"},
		{"type":"text","text":"## 3 · Doble cervell\n25-27/10 · núvol + local","id":"n5","x":1020,"y":-110,"width":300,"height":80,"color":"4"},
		{"type":"text","text":"## 4 · Avui\n30-31/10 · v6.10.2","id":"n6","x":1360,"y":-110,"width":300,"height":80,"color":"6"},
		{"type":"text","text":"### Cervell","id":"n7","x":-280,"y":0,"width":240,"height":140,"color":"2"},
		{"type":"text","text":"Doble cervell Groq + Ollama: Groq ràpid, Ollama sense xarxa.","id":"n8","x":0,"y":0,"width":300,"height":140,"color":"1"},
		{"type":"text","text":"Només Groq `llama-3.3-70b` per centrar-se en memòria, veu i cara.","id":"n9","x":340,"y":0,"width":300,"height":140,"color":"5"},
		{"type":"text","text":"Ollama `qwen2.5:3b`: entén el context, però 8,75 s de TTFT.","id":"n10","x":680,"y":0,"width":300,"height":140,"color":"3"},
		{"type":"text","text":"Núvol `gpt-oss-20b` + local de respostal. Ruta completa 1,23 s.","id":"n11","x":1020,"y":0,"width":300,"height":140,"color":"4"},
		{"type":"text","text":"Modes auto/núvol/local per veu; si retiren el model, en tria un altre.","id":"n12","x":1360,"y":0,"width":300,"height":140,"color":"6"},
		{"type":"text","text":"### Oïda","id":"n13","x":-280,"y":160,"width":240,"height":140,"color":"2"},
		{"type":"text","text":"Barra espaiadora, senyal per la cua i un `.wav` per torn.","id":"n14","x":0,"y":160,"width":300,"height":140,"color":"1"},
		{"type":"text","text":"Pygame i micròfon del PC; encara sense VAD.","id":"n15","x":340,"y":160,"width":300,"height":140,"color":"5"},
		{"type":"text","text":"VAD continu, tall 0,6 s; Whisper `base` 1,6-2,0 s.","id":"n16","x":680,"y":160,"width":300,"height":140,"color":"3"},
		{"type":"text","text":"STT al núvol 0,68 s; local de respostal.","id":"n17","x":1020,"y":160,"width":300,"height":140,"color":"4"},
		{"type":"text","text":"Micro USB amb espera de 25 s; reparació i *hotwords*.","id":"n18","x":1360,"y":160,"width":300,"height":140,"color":"6"},
		{"type":"text","text":"### Veu","id":"n19","x":-280,"y":320,"width":240,"height":140,"color":"2"},
		{"type":"text","text":"El document no fixa motor; la veu és una peça prevista.","id":"n20","x":0,"y":320,"width":300,"height":140,"color":"1"},
		{"type":"text","text":"Piper local; primera veu intel·ligible.","id":"n21","x":340,"y":320,"width":300,"height":140,"color":"5"},
		{"type":"text","text":"Piper 0,36 s/frase; volum per ordres directes.","id":"n22","x":680,"y":320,"width":300,"height":140,"color":"3"},
		{"type":"text","text":"Primera frase sintetitzada mentre el model genera.","id":"n23","x":1020,"y":320,"width":300,"height":140,"color":"4"},
		{"type":"text","text":"Edge Ximena + Piper de respostal; volum 1-100.","id":"n24","x":1360,"y":320,"width":300,"height":140,"color":"6"},
		{"type":"text","text":"### Memòria","id":"n25","x":-280,"y":480,"width":240,"height":140,"color":"2"},
		{"type":"text","text":"Primera base; fallava en català i castellà.","id":"n27","x":340,"y":480,"width":300,"height":140,"color":"5"},
		{"type":"text","text":"MiniLM multilingüe, només missatge d'usuari, llindar 0,58.","id":"n28","x":680,"y":480,"width":300,"height":140,"color":"3"},
		{"type":"text","text":"52 records/205 converses; consulta ~150 ms.","id":"n29","x":1020,"y":480,"width":300,"height":140,"color":"4"},
		{"type":"text","text":"Tema 85-100 %; detall 4/8; segona memòria dissenyada.","id":"n30","x":1360,"y":480,"width":300,"height":140,"color":"6"},
		{"type":"text","text":"### Cara","id":"n31","x":-280,"y":640,"width":240,"height":140,"color":"2"},
		{"type":"text","text":"Set imatges estàtiques de BMO (`assets/caras/`).","id":"n32","x":0,"y":640,"width":300,"height":140,"color":"1"},
		{"type":"text","text":"Pàgina web local; ulls i boca per separat.","id":"n33","x":340,"y":640,"width":300,"height":140,"color":"5"},
		{"type":"text","text":"Cara vectorial; PySide6 i pantalla SPI 240×240.","id":"n34","x":680,"y":640,"width":300,"height":140,"color":"3"},
		{"type":"text","text":"12 principis, lip-sync i director de gestos.","id":"n35","x":1020,"y":640,"width":300,"height":140,"color":"4"},
		{"type":"text","text":"Gestos per silenci, intro i correcció dels ulls.","id":"n36","x":1360,"y":640,"width":300,"height":140,"color":"6"},
		{"type":"text","text":"### Personalitat","id":"n37","x":-280,"y":800,"width":240,"height":140,"color":"2"},
		{"type":"text","text":"Referent BMO/Baymax: amigable, curiós, fa la seva vida.","id":"n38","x":0,"y":800,"width":300,"height":140,"color":"1"},
		{"type":"text","text":"Fitxa bàsica i regles per evitar el to d'assistent.","id":"n39","x":340,"y":800,"width":300,"height":140,"color":"5"},
		{"type":"text","text":"Ànim, víncle i iniciativa cada 15 min.","id":"n40","x":680,"y":800,"width":300,"height":140,"color":"3"},
		{"type":"text","text":"Bandit, rotació de fitxa i frases amb llavor.","id":"n41","x":1020,"y":800,"width":300,"height":140,"color":"4"},
		{"type":"text","text":"Explica què ha dit; no té cos ni promet accions físiques.","id":"n42","x":1360,"y":800,"width":300,"height":140,"color":"6"},
		{"type":"text","text":"### Agenda i el dia","id":"n43","x":-280,"y":960,"width":240,"height":140,"color":"2"},
		{"type":"text","text":"No hi era.","id":"n44","x":0,"y":960,"width":300,"height":140,"color":"1"},
		{"type":"text","text":"No hi era.","id":"n45","x":340,"y":960,"width":300,"height":140,"color":"5"},
		{"type":"text","text":"v6.3 alarmes i cites; v6.4 rutines, apunts, temps i música.","id":"n46","x":680,"y":960,"width":300,"height":140,"color":"3"},
		{"type":"text","text":"Reprogramació de cites; correcció del comptador.","id":"n47","x":1020,"y":960,"width":300,"height":140,"color":"4"},
		{"type":"text","text":"Agenda local, rutines, notes, música i apagada.","id":"n48","x":1360,"y":960,"width":300,"height":140,"color":"6"},
		{"type":"text","text":"### Maquinari","id":"n49","x":-280,"y":1120,"width":240,"height":140,"color":"2"},
		{"type":"text","text":"Raspberry Pi 5 8 GB; 250 €; tres plans.","id":"n50","x":0,"y":1120,"width":300,"height":140,"color":"1"},
		{"type":"text","text":"PC amb Pygame; sense pantalla dedicada.","id":"n51","x":340,"y":1120,"width":300,"height":140,"color":"5"},
		{"type":"text","text":"Orange Pi 5 Pro, GC9A01, micro USB i altaveu.","id":"n52","x":680,"y":1120,"width":300,"height":140,"color":"3"},
		{"type":"text","text":"Cron, versió i empremta; còpies al PC.","id":"n53","x":1020,"y":1120,"width":300,"height":140,"color":"4"},
		{"type":"text","text":"Carcassa i ventilació pendents; pressupost 275,52 €.","id":"n54","x":1360,"y":1120,"width":300,"height":140,"color":"6"},
		{"type":"text","text":"### Document original","id":"n55","x":-280,"y":1280,"width":240,"height":140,"color":"2"},
		{"type":"text","text":"Text en català; quatre peces; 11/08/2026.","id":"n56","x":0,"y":1280,"width":300,"height":140,"color":"1"},
		{"type":"text","text":"2a actualització: memòria multilingüe i tres llenguatges visuals.","id":"n57","x":340,"y":1280,"width":300,"height":140,"color":"5"},
		{"type":"text","text":"Es combina amb les mesures reals a `historia.md`.","id":"n58","x":680,"y":1280,"width":300,"height":140,"color":"3"},
		{"type":"text","text":"Les decisions del paper es revisen amb dades.","id":"n59","x":1020,"y":1280,"width":300,"height":140,"color":"4"},
		{"type":"text","text":"És la font del TREC; no es toca, es contrasta.","id":"n60","x":1360,"y":1280,"width":300,"height":140,"color":"6"},
		{"type":"text","text":"**Com llegir-lo:** les columnes no són mesos exactes, són **etapes**. Una cel·la buida o curta vol dir que aquella part encara no existia. Les notes de cada part desenvolupen el detall, les mesures i els errors.","id":"n61","x":-280,"y":1480,"width":1900,"height":100,"color":"1"},
		{"type":"text","text":"ChromaDB + RAG; el «diari» vectorial.","id":"n26","x":0,"y":480,"width":300,"height":140,"color":"1"}
	],
	"edges":[]
}